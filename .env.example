# ─────────────────────────────────────────────────────────────
# Madras Cloth Emporium — environment variables
# Local:  `npm run setup` creates .env.local for you.
# Netlify: Site configuration → Environment variables.
# NEVER commit real values. Only NEXT_PUBLIC_* values reach the browser.
# ─────────────────────────────────────────────────────────────

# Public URL of the site (used for SEO, sitemap, WhatsApp links)
NEXT_PUBLIC_SITE_URL=https://your-site.netlify.app

# Database — leave empty locally to use the embedded database (.data/pglite).
# Production: Supabase → Project → Connect → "Transaction pooler" URI (port 6543).
DATABASE_URL=

# Admin login (single owner account). Generate with:
#   npm run admin:hash -- "a-long-strong-password"
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# Optional — product photo uploads (Supabase Storage, free 1 GB)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=product-images

# Optional — email alerts to the owner for new orders/enquiries (Resend free tier)
RESEND_API_KEY=
NOTIFY_EMAIL=sanjayyes9@gmail.com

# Future integrations (leave unset in v1)
PAYMENTS_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
LOYALTY_ENABLED=false
